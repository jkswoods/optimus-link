$C = "../../Common.ui";
$H = "Handset.ui";
SceneBlur {}
$C.@PageOverlay {
 Group #HandsetLayout {
  Anchor: (Width: 1280, Height: 900);
  $C.@DecoratedContainer #FleetContainer {
   @CloseButton = true;
   Anchor: (Left: 0, Top: 0, Width: 1280, Height: 900);
   #Title {
    Anchor: (Height: 56, Top: 0); Padding: (Full: 0);
    Background: $H.@Header;
    Label { Anchor: (Full: 0); Padding: (Left: 36); Text: "OPTIMUS / FLEET REMOTE"; Style: (FontName: "Secondary", FontSize: 25, LetterSpacing: 1, TextColor: #c6dff6, RenderBold: true, VerticalAlignment: Center); }
   }
   #CloseButton { Anchor: (Width: 48, Height: 48, Top: 4, Right: 6); Style: $H.@CloseStyle; }
   #Content {
    Anchor: (Top: 56); LayoutMode: Top; Padding: (Full: 36, Top: 18, Bottom: 24);
    Background: $H.@PanelBody;
    Group {
     Anchor: (Height: 52); LayoutMode: Left;
     Label #Summary { FlexWeight: 1; Style: (FontSize: 32, LetterSpacing: 1, TextColor: #e2ebf5, RenderBold: true, VerticalAlignment: Center); }
     Label #Availability { Anchor: (Width: 420); Style: (FontSize: 16, LetterSpacing: 1, TextColor: #b4c8e3, RenderBold: true, HorizontalAlignment: End, VerticalAlignment: Center); }
    }
    Group {
     Anchor: (Height: 72); LayoutMode: Left;
     TextField #Search {
      FlexWeight: 1; Anchor: (Height: 52); MaxLength: 64; PlaceholderText: "Search robots by name...";
      Background: (TexturePath: "Field.png", Border: 3); Padding: (Left: 54, Right: 16);
      Style: $H.@InputStyle; PlaceholderStyle: $H.@PlaceholderStyle;
      Decoration: (Default: (Icon: (Texture: "../../Common/SearchIcon.png", Width: 24, Height: 24, Offset: 18)));
     }
     Group { Anchor: (Width: 24); }
     DropdownBox #Sort { Anchor: (Width: 304, Height: 52); Style: $H.@SortStyle; }
    }
    Label #Message { Visible: false; Anchor: (Height: 36); Style: (FontSize: 18, TextColor: #b8d7e6, Wrap: true, VerticalAlignment: Center); }
    Group { FlexWeight: 1;
     Group #RobotList { LayoutMode: TopScrolling; ScrollbarStyle: $H.@Scrollbar; }
     Label #Empty { Visible: false; Anchor: (Full: 24); HitTestVisible: false; Style: (FontSize: 22, TextColor: #a7bbd3, Wrap: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
    }
    Group { Anchor: (Width: 1208, Height: 2); Background: #344459; }
    Group {
     Anchor: (Height: 48); LayoutMode: Left; Padding: (Top: 8);
     Group { Anchor: (Width: 26, Height: 26, Top: 7); Background: (TexturePath: "Info.png"); }
     Group { Anchor: (Width: 16); }
     Label { FlexWeight: 1; Text: "Your body stays in the world while you control a robot."; Style: (FontSize: 20, TextColor: #adc7e5, VerticalAlignment: Center); }
     Group { Anchor: (Width: 138, Height: 40); LayoutMode: Left; BackButton {} }
    }
   }
  }
  Group #EditorLayer {
   Visible: false; Anchor: (Left: 1336, Top: 0, Width: 480, Height: 900);
   $C.@DecoratedContainer #EditContainer {
    @CloseButton = true; Anchor: (Full: 0);
    #Title {
     Anchor: (Height: 56, Top: 0); Padding: (Full: 0);
     Background: $H.@Header;
     Label { Anchor: (Full: 0); Padding: (Left: 32); Text: "EDIT ROBOT"; Style: (FontName: "Secondary", FontSize: 25, LetterSpacing: 1, TextColor: #c6dff6, RenderBold: true, VerticalAlignment: Center); }
    }
    #CloseButton { Anchor: (Width: 48, Height: 48, Top: 4, Right: 6); Style: $H.@CloseStyle; }
    #Content {
     Anchor: (Top: 56); Padding: (Full: 32, Top: 18, Bottom: 20); LayoutMode: Top;
     Background: $H.@PanelBody;
     Group #EditPreviewGroup { Anchor: (Height: 320); LayoutMode: Center;
      Group #EditPortrait { Anchor: (Width: 300, Height: 300); Background: (TexturePath: "Portraits/white-bust.png"); }
     }
     Label #EditTitle { Anchor: (Height: 44); Style: (FontSize: 32, TextColor: #e2ebf5, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
     Label { Anchor: (Height: 34); Text: "Name"; Style: (FontSize: 20, TextColor: #d5dfec, RenderBold: true); }
     TextField #EditName { Anchor: (Height: 52); MaxLength: 24; PlaceholderText: "Robot name"; Background: (TexturePath: "Field.png", Border: 3); Padding: (Horizontal: 18); Style: $H.@InputStyle; PlaceholderStyle: $H.@PlaceholderStyle; }
     Group { Anchor: (Height: 18); }
     Label { Anchor: (Height: 34); Text: "Colour"; Style: (FontSize: 20, TextColor: #d5dfec, RenderBold: true); }
     Group #Colours { Anchor: (Height: 64); LayoutMode: Left;
    Button #Colourwhite { Anchor: (Width: 58, Height: 56); Padding: (Full: 5); Style: $H.@SwatchStyle; TooltipText: "White"; TextTooltipStyle: $C.@DefaultTextTooltipStyle;
     Group { Background: #e5e5df; HitTestVisible: false;
      Group #Checkwhite { Visible: false; Anchor: (Full: -3); Background: (TexturePath: "SwatchSelected.png", Border: 3); HitTestVisible: false;
       Group { Anchor: (Full: 10); Background: (TexturePath: "../../Common/Checkmark.png", Color: #15202d); HitTestVisible: false; }
      }
     }
    }
    Group { Anchor: (Width: 13); }
    Button #Colourgraphite { Anchor: (Width: 58, Height: 56); Padding: (Full: 5); Style: $H.@SwatchStyle; TooltipText: "Graphite"; TextTooltipStyle: $C.@DefaultTextTooltipStyle;
     Group { Background: #68747e; HitTestVisible: false;
      Group #Checkgraphite { Visible: false; Anchor: (Full: -3); Background: (TexturePath: "SwatchSelected.png", Border: 3); HitTestVisible: false;
       Group { Anchor: (Full: 10); Background: (TexturePath: "../../Common/Checkmark.png", Color: #15202d); HitTestVisible: false; }
      }
     }
    }
    Group { Anchor: (Width: 13); }
    Button #Colourblue { Anchor: (Width: 58, Height: 56); Padding: (Full: 5); Style: $H.@SwatchStyle; TooltipText: "Blue"; TextTooltipStyle: $C.@DefaultTextTooltipStyle;
     Group { Background: #557eaf; HitTestVisible: false;
      Group #Checkblue { Visible: false; Anchor: (Full: -3); Background: (TexturePath: "SwatchSelected.png", Border: 3); HitTestVisible: false;
       Group { Anchor: (Full: 10); Background: (TexturePath: "../../Common/Checkmark.png", Color: #15202d); HitTestVisible: false; }
      }
     }
    }
    Group { Anchor: (Width: 13); }
    Button #Colourochre { Anchor: (Width: 58, Height: 56); Padding: (Full: 5); Style: $H.@SwatchStyle; TooltipText: "Ochre"; TextTooltipStyle: $C.@DefaultTextTooltipStyle;
     Group { Background: #ac863e; HitTestVisible: false;
      Group #Checkochre { Visible: false; Anchor: (Full: -3); Background: (TexturePath: "SwatchSelected.png", Border: 3); HitTestVisible: false;
       Group { Anchor: (Full: 10); Background: (TexturePath: "../../Common/Checkmark.png", Color: #15202d); HitTestVisible: false; }
      }
     }
    }
    Group { Anchor: (Width: 13); }
    Button #Colourgreen { Anchor: (Width: 58, Height: 56); Padding: (Full: 5); Style: $H.@SwatchStyle; TooltipText: "Green"; TextTooltipStyle: $C.@DefaultTextTooltipStyle;
     Group { Background: #648164; HitTestVisible: false;
      Group #Checkgreen { Visible: false; Anchor: (Full: -3); Background: (TexturePath: "SwatchSelected.png", Border: 3); HitTestVisible: false;
       Group { Anchor: (Full: 10); Background: (TexturePath: "../../Common/Checkmark.png", Color: #15202d); HitTestVisible: false; }
      }
     }
    }
    Group { Anchor: (Width: 13); }
    Button #Colourred { Anchor: (Width: 58, Height: 56); Padding: (Full: 5); Style: $H.@SwatchStyle; TooltipText: "Red"; TextTooltipStyle: $C.@DefaultTextTooltipStyle;
     Group { Background: #a45852; HitTestVisible: false;
      Group #Checkred { Visible: false; Anchor: (Full: -3); Background: (TexturePath: "SwatchSelected.png", Border: 3); HitTestVisible: false;
       Group { Anchor: (Full: 10); Background: (TexturePath: "../../Common/Checkmark.png", Color: #15202d); HitTestVisible: false; }
      }
     }
    }
     }
     Label #EditStatus { Anchor: (Height: 44); Style: (FontSize: 17, TextColor: #a7bbd3, Wrap: true); }
     TextButton #Save { Anchor: (Height: 56); Text: "Save changes"; Style: $H.@ActionStyle; }
     Group { Anchor: (Height: 24); }
     Group { Anchor: (Width: 416, Height: 2); Background: #344459; }
     Group { Anchor: (Height: 22); }
     TextButton #Unlink { Anchor: (Height: 54); Text: "Unlink robot"; Style: $H.@UnlinkStyle; }
     Label { Anchor: (Height: 36); Text: "Keeps the robot and its inventory."; Style: (FontSize: 16, TextColor: #a7bbd3, HorizontalAlignment: Center, VerticalAlignment: Center); }
     Group #UnlinkConfirmation { Visible: false; Anchor: (Height: 96); LayoutMode: Top;
      Label { Anchor: (Height: 38); Text: "Unlink this robot from this remote?"; Style: (FontSize: 17, TextColor: #e5bdad, HorizontalAlignment: Center); }
      Group { Anchor: (Height: 44); LayoutMode: Left;
       TextButton #ConfirmUnlink { FlexWeight: 1; Text: "Confirm unlink"; Style: $H.@UnlinkStyle; }
       Group { Anchor: (Width: 12); }
       TextButton #CancelUnlink { Anchor: (Width: 100, Height: 44); Text: "Cancel"; Style: $H.@ActionStyle; }
      }
     }
    }
   }
  }
 }
}
