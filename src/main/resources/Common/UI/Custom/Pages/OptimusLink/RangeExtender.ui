$C = "../../Common.ui";
$R = "RangeAppearance.ui";
SceneBlur {}
$C.@PageOverlay {
 Group #RangeRoot {
  Anchor: (Width: 780, Height: 972); LayoutMode: Left;
  Group {
   Anchor: (Width: 780); LayoutMode: Top;
   $C.@Container #MastContainer {
    @CloseButton = true; Anchor: (Height: 430);
    #Title { $C.@Title { @Text = "RANGE EXTENDER"; @Alignment = Start; } }
    #Content {
     LayoutMode: Left;
     Group {
      Anchor: (Width: 356); Padding: (Full: 12); LayoutMode: Top; Background: #141b25;
      Label { Anchor: (Height: 30); Text: "LINK REMOTE"; Style: $R.@SectionTitle; }
      Group { Anchor: (Height: 176); LayoutMode: Center;
       Group { Anchor: (Width: 140, Height: 140); Background: $R.@Slot;
        ItemIcon #RemoteIcon { Anchor: (Full: 8); ItemId: "OP_Remote"; Visible: false; HitTestVisible: false; }
        Label #EmptyRemote { Anchor: (Full: 10); Text: "PLACE REMOTE"; HitTestVisible: false; Style: (FontSize: 15, TextColor: #96a9be, Wrap: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
        Button #RemoteSlot { Anchor: (Full: 0); Style: $R.@SlotNormal; }
       }
      }
      Group { Anchor: (Height: 30); LayoutMode: Center;
       Group { Anchor: (Width: 240, Height: 10);
        $C.@ProgressBar #Signal { Anchor: (Width: 240, Height: 10); }
       }
       Label #Progress { Anchor: (Width: 56); Style: (FontSize: 17, TextColor: #d3d6db, HorizontalAlignment: End, VerticalAlignment: Center); }
      }
      Label #PairStatus { Anchor: (Height: 30); Style: (FontSize: 18, TextColor: #d3d6db, HorizontalAlignment: Center, VerticalAlignment: Center); }
      Label #Notice { Anchor: (Height: 42); Style: (FontSize: 16, TextColor: #96a9be, Wrap: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
     }
     Group { Anchor: (Width: 10); }
     Group {
      FlexWeight: 1; Padding: (Full: 12); LayoutMode: Top; Background: #141b25;
      Label { Anchor: (Height: 30); Text: "SIGNAL NETWORK"; Style: $R.@SectionTitle; }
      Group { Anchor: (Height: 100); LayoutMode: Left; Padding: (Top: 18, Bottom: 18);
       Group { Anchor: (Width: 44, Height: 44); Background: "RangeRadio.png"; }
       Group { Anchor: (Width: 12); }
       Group { FlexWeight: 1; LayoutMode: Top;
        Label { Anchor: (Height: 26); Text: "128-block radius"; Style: (FontSize: 19, TextColor: #d3d6db, VerticalAlignment: Center); }
        Label #NetworkStatus { Anchor: (Height: 24); Style: (FontSize: 17, TextColor: #55c889, VerticalAlignment: Center); }
       }
      }
      Group { Anchor: (Height: 1); Background: #313d4c; }
      Label { Anchor: (Height: 28); Text: "LINKED REMOTES"; Style: $R.@SectionTitle; }
      Label #LinkedCount { Anchor: (Height: 20); Style: (FontSize: 15, TextColor: #96a9be, VerticalAlignment: Center); }
      Group #LinkedList { FlexWeight: 1; LayoutMode: TopScrolling; ScrollbarStyle: $C.@DefaultScrollbarStyle; }
     }
    }
   }
   Group { Anchor: (Height: 10); }
   $C.@Container #InventoryContainer {
    Anchor: (Height: 488);
    #Title { $C.@Title { @Text = "INVENTORY"; @Alignment = Start; } }
    #Content {
     LayoutMode: Top;
     Group { Anchor: (Height: 320); LayoutMode: Center;
      Group #StorageRows { Anchor: (Width: 720, Height: 320); LayoutMode: Top; }
     }
     Group { Anchor: (Height: 8); }
     Group { Anchor: (Height: 80); LayoutMode: Center;
      Group #HotbarRow { Anchor: (Width: 720, Height: 80); LayoutMode: Left; }
     }
    }
   }
   Group { FlexWeight: 1; }
   Group { Anchor: (Height: 34); LayoutMode: Left; Group { FlexWeight: 1; } BackButton {} }
  }
  Group #BackpackPane {
   Anchor: (Width: 0); Visible: false; Padding: (Left: 16, Top: 440); LayoutMode: Top;
   $C.@Container #BackpackContainer {
    Anchor: (Height: 392);
    #Title { $C.@Title { @Text = "BACKPACK"; @Alignment = Start; } }
    #Content {
     Group { Anchor: (Height: 320); LayoutMode: Center;
      Group #BackpackRows { Anchor: (Width: 720, Height: 320); LayoutMode: Top; }
     }
    }
   }
  }
 }
}
