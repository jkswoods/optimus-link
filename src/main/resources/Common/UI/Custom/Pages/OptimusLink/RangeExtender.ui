$C = "../../Common.ui";
$H = "Handset.ui";
$R = "RangeAppearance.ui";
SceneBlur {}
$C.@PageOverlay {
 $C.@DecoratedContainer #MastContainer {
  @CloseButton = true; Anchor: (Width: 1280, Height: 1030);
  #Title {
   Anchor: (Height: 56, Top: 0); Padding: (Full: 0); Background: $H.@Header;
   Label { Anchor: (Full: 0); Padding: (Left: 32); Text: "OPTIMUS / RANGE EXTENDER"; Style: (FontName: "Secondary", FontSize: 25, LetterSpacing: 1, TextColor: #c6dff6, RenderBold: true, VerticalAlignment: Center); }
  }
  #CloseButton { Anchor: (Width: 48, Height: 48, Top: 4, Right: 6); Style: $H.@CloseStyle; }
  #Content {
   Anchor: (Top: 56); Padding: (Full: 28, Top: 12, Bottom: 12); LayoutMode: Top; Background: $H.@PanelBody;
   Group { Anchor: (Height: 368); LayoutMode: Left;
    Group { Anchor: (Width: 652); LayoutMode: Top; Padding: (Full: 8); Background: $R.@Panel;
     Group { Anchor: (Height: 40); Background: $R.@Header;
      Label { Anchor: (Full: 0); Padding: (Left: 20); Text: "LINK REMOTE"; Style: $R.@SectionTitle; }
     }
     Group { Anchor: (Height: 208); LayoutMode: Center;
      Group { Anchor: (Width: 200, Height: 200); Background: $R.@Slot;
       ItemIcon #RemoteIcon { Anchor: (Full: 20); ItemId: "OP_Remote"; Visible: false; HitTestVisible: false; }
       Label #EmptyRemote { Anchor: (Full: 14); Text: "PLACE REMOTE"; HitTestVisible: false; Style: (FontSize: 18, TextColor: #91a8c0, Wrap: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
       Button #RemoteSlot { Anchor: (Full: 0); Style: $R.@SlotNormal; }
      }
     }
     Group { Anchor: (Height: 34); LayoutMode: Center;
      Group { Anchor: (Width: 496, Height: 30); Padding: (Left: 8, Top: 4, Right: 8, Bottom: 4); Background: $R.@Slot;
       Group #Signal { Anchor: (Full: 0); LayoutMode: Left; }
      }
      Label #Progress { Anchor: (Width: 64); Padding: (Left: 8); Style: (FontSize: 20, TextColor: #e0f8f2, HorizontalAlignment: End, VerticalAlignment: Center); }
     }
     Label #PairStatus { Anchor: (Height: 28); Style: (FontSize: 21, TextColor: #dbe9f7, HorizontalAlignment: Center, VerticalAlignment: Center); }
     Label #Notice { Anchor: (Height: 34); Style: (FontSize: 18, TextColor: #a7c0d8, Wrap: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
    }
    Group { Anchor: (Width: 16); }
    Group { FlexWeight: 1; LayoutMode: Top; Padding: (Full: 8); Background: $R.@Panel;
     Group { Anchor: (Height: 40); Background: $R.@Header;
      Label { Anchor: (Full: 0); Padding: (Left: 20); Text: "SIGNAL NETWORK"; Style: $R.@SectionTitle; }
     }
     Group { Anchor: (Height: 96); LayoutMode: Left; Padding: (Full: 18, Top: 16, Bottom: 16);
      Group { Anchor: (Width: 64, Height: 64); Background: "RangeRadio.png"; }
      Group { Anchor: (Width: 20); }
      Group { FlexWeight: 1; LayoutMode: Top;
       Label { Anchor: (Height: 32); Text: "128-block radius"; Style: (FontSize: 24, TextColor: #dbe9f7, VerticalAlignment: Center); }
       Label #NetworkStatus { Anchor: (Height: 28); Style: (FontSize: 21, TextColor: #58d5b4, VerticalAlignment: Center); }
      }
     }
     Group { Anchor: (Height: 2, Left: 18, Right: 18); Background: $R.@Separator; }
     Label { Anchor: (Height: 34); Padding: (Left: 18); Text: "LINKED REMOTES"; Style: (FontName: "Secondary", FontSize: 22, TextColor: #c6dff6, RenderBold: true, VerticalAlignment: Center); }
     Label #LinkedCount { Anchor: (Height: 20); Padding: (Left: 18); Style: (FontSize: 17, TextColor: #9eb6d0, VerticalAlignment: Center); }
     Group #LinkedList { FlexWeight: 1; Padding: (Left: 14, Right: 14); LayoutMode: TopScrolling; ScrollbarStyle: $H.@Scrollbar; }
    }
   }
   Group { Anchor: (Height: 12); }
   Group { Anchor: (Height: 536); LayoutMode: Top; Padding: (Full: 12, Top: 0, Bottom: 8); Background: $R.@Panel;
    Group { Anchor: (Height: 40); Background: $R.@Header;
     Label { Anchor: (Full: 0); Padding: (Left: 18); Text: "PLAYER INVENTORY"; Style: $R.@SectionTitle; }
    }
    Group { Anchor: (Height: 4); }
    Group { Anchor: (Height: 360); LayoutMode: Center;
     Group #StorageRows { Anchor: (Width: 1096, Height: 360); LayoutMode: TopScrolling; ScrollbarStyle: $H.@Scrollbar; }
    }
    Group { Anchor: (Height: 4); }
    Group { Anchor: (Height: 120); LayoutMode: Center;
     Group #HotbarRow { Anchor: (Width: 1096, Height: 120); LayoutMode: Left; }
    }
   }
   Group { FlexWeight: 1; }
   Group { Anchor: (Height: 34); LayoutMode: Left;
    Label { FlexWeight: 1; Text: "Scroll the inventory for more storage slots."; Style: (FontSize: 18, TextColor: #a7c0d8, VerticalAlignment: Center); }
    Group { Anchor: (Width: 138, Height: 32); LayoutMode: Left; BackButton {} }
   }
  }
 }
}
