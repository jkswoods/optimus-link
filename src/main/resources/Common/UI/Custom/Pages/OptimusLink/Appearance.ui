@Previewgraphite = PatchStyle(TexturePath: "Portraits/graphite-bust.png");
@Portraitblue = PatchStyle(TexturePath: "Portraits/blue-roster.png");
@Previewblue = PatchStyle(TexturePath: "Portraits/blue-bust.png");
@Portraitochre = PatchStyle(TexturePath: "Portraits/ochre-roster.png");
@Previewochre = PatchStyle(TexturePath: "Portraits/ochre-bust.png");
@Portraitgreen = PatchStyle(TexturePath: "Portraits/green-roster.png");
@Previewgreen = PatchStyle(TexturePath: "Portraits/green-bust.png");
@Portraitred = PatchStyle(TexturePath: "Portraits/red-roster.png");
@Previewred = PatchStyle(TexturePath: "Portraits/red-bust.png");
@AvailableName = #f0f3fb;
@UnavailableName = #7f8da8;
@AvailableStatus = #b5c7dc;
@UnavailableStatus = #8999b3;
@RowNormal = PatchStyle(TexturePath: "RowNormal.png", Border: 2);
