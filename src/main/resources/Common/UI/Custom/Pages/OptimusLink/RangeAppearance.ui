$C = "../../Common.ui";
@Slot = PatchStyle(TexturePath: "../../../ItemQualities/Slots/SlotDefault.png", Border: 4);
@SlotNormal = ButtonStyle(
 Default: (Background: (Color: #ffffff(0))),
 Hovered: (Background: (Color: #ffffff(0.04))),
 Pressed: (Background: (Color: #ffffff(0.10))),
 Sounds: $C.@ButtonSounds
);
@CloseStyle = ButtonStyle(
 Default: (Background: "../../Common/ContainerCloseButton.png"),
 Hovered: (Background: "../../Common/ContainerCloseButtonHovered.png"),
 Pressed: (Background: "../../Common/ContainerCloseButtonPressed.png"),
 Sounds: $C.@ButtonsCancel
);
@SectionTitle = LabelStyle(FontSize: 15, TextColor: #b4c8c9, RenderBold: true, VerticalAlignment: Center);
