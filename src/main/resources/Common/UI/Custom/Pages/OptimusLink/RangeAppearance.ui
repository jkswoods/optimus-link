$C = "../../Common.ui";
@Panel = PatchStyle(TexturePath: "RangePanel.png", Border: 8);
@Slot = PatchStyle(TexturePath: "RangeSlot.png", Border: 8);
@Selected = PatchStyle(TexturePath: "RangeSelected.png", Border: 4);
@SignalOn = PatchStyle(TexturePath: "RangeSignalOn.png", Border: 2);
@SignalOff = PatchStyle(TexturePath: "RangeSignalOff.png", Border: 2);
@SlotNormal = ButtonStyle(
 Default: (Background: (Color: #ffffff(0))),
 Hovered: (Background: (Color: #ffffff(0.04))),
 Pressed: (Background: (Color: #ffffff(0.10))),
 Sounds: $C.@ButtonSounds
);

@Header = PatchStyle(TexturePath: "RangeHeader.png", Border: 6);
@Separator = PatchStyle(Color: #496279);
@SectionTitle = LabelStyle(FontName: "Secondary", FontSize: 25, LetterSpacing: 1, TextColor: #c6dff6, RenderBold: true, VerticalAlignment: Center);
